# Supply-chain safety: refuse package versions published less than 1 day ago.
# Originally 7 days, but lowered to 1 day so freshly-released stable versions of
# actively-maintained packages (Vue, Tailwind, Vite plugin) can be installed at
# their latest. Still blocks zero-day malicious releases published the same day.
# Honoured by pnpm and bun.
minimum-release-age=1440
